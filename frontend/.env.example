# Frontend env (M-Ops F4). Copie pra `.env.local`.

# URL do backend FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (M4) — o login do front passa por aqui. Vazios = login Supabase não
# funciona local (use o backend em modo test-auth via API direta).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
