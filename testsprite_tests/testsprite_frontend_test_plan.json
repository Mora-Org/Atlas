  {
    "id": "TC001",
    "title": "Open schema editor from the tables list",
    "description": "This verifies an authenticated administrator can reach a table’s schema editor from the tables list and see the existing schema details.",
    "category": "Schema editor for existing table",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Fill {{LOGIN_USER}} into the username field"
      },
      {
        "type": "action",
        "description": "Fill {{LOGIN_PASSWORD}} into the password field"
      },
      {
        "type": "action",
        "description": "Submit the login form"
      },
      {
        "type": "action",
        "description": "Navigate to /admin/tables"
      },
      {
        "type": "action",
        "description": "Click the schema entry point for a table row"
      },
      {
        "type": "assertion",
        "description": "Verify the schema editor is displayed"
      },
      {
        "type": "assertion",
        "description": "Verify existing columns and schema badges are shown"
      }
    ],
    "priority": "High"
  },
