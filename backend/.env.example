# Atlas backend — template de variáveis de ambiente (atualizado no M-Ops F4).
# Copie pra .env / .env.development (gitignored) e ajuste pro seu setup local.

# === Database ===
# SQLite (default, dev rápido):
DATABASE_URL=sqlite:///./dynamic_template.db
# Postgres local (M3 Fase 0.2):
# DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/dynamic_cms
# Postgres de teste (M3 Fase 7):
# DATABASE_URL_TEST=postgresql+psycopg2://postgres:devpass@localhost:5432/dynamic_cms_test

# === Auth (Supabase, M4) ===
# Vazios em dev local → o backend cai no modo test-auth (aceita tokens
# "test-<username>"). OBRIGATÓRIOS em prod pra validar os JWT (JWKS do Supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (O SECRET_KEY do JWT custom HS256 foi APOSENTADO no M4 — não é mais lido.)

# === CORS (M-Ops F4) ===
# Vazio = ["*"] (dev). Em prod, lista separada por vírgula com as origins reais
# do front, ex.: https://atlas-mora.vercel.app
CORS_ORIGINS=

# === Seed do testadmin ===
# Em sqlite local seeda por padrão (os e2e do front logam como testadmin). Em
# prod (postgres) NÃO seeda a menos que ENABLE_TEST_SEED=1. SKIP_TEST_SEED
# desliga de vez (setado pelo conftest do pytest).
# ENABLE_TEST_SEED=1
# SKIP_TEST_SEED=1
