# Atlas backend — template de variáveis de ambiente (atualizado no M-Ops F4).
# Copie pra .env / .env.development (gitignored) e ajuste pro seu setup local.

# === Database ===
# SQLite (default, dev rápido):
DATABASE_URL=sqlite:///./dynamic_template.db
# Postgres local (M3 Fase 0.2):
# DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/dynamic_cms
# Postgres de teste (M3 Fase 7):
# DATABASE_URL_TEST=postgresql+psycopg2://postgres:devpass@localhost:5432/dynamic_cms_test

# === Auth (Supabase, M4) ===
# Vazios em dev local → o backend cai no modo test-auth (aceita tokens
# "test-<username>"). OBRIGATÓRIOS em prod pra validar os JWT (JWKS do Supabase).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (O SECRET_KEY do JWT custom HS256 foi APOSENTADO no M4 — não é mais lido.)

# === CORS (M-Ops F4) ===
# Vazio = ["*"] (dev). Em prod, lista separada por vírgula com as origins reais
# do front, ex.: https://atlas-mora.vercel.app
CORS_ORIGINS=

# === Webhooks (M9 F3) ===
# Chave Fernet que CIFRA o segredo de assinatura de cada webhook no banco.
# Diferente da API key (que só guarda digest), aqui o Atlas precisa RECOMPUTAR
# o HMAC a cada tentativa no drain — então o segredo tem que voltar em claro, e
# o que protege é a chave morar fora do banco.
# Sem ela, criar webhook devolve 503 explicando (nunca grava em texto puro nem
# inventa chave efêmera, que quebraria as assinaturas no primeiro restart).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATLAS_WEBHOOK_SIGNING_KEY=

# Token do endpoint de serviço POST /api/webhooks/drain, que o agendador
# externo chama (.github/workflows/webhook-drain.yml, a cada 5 min).
# Sem ele o endpoint devolve 503 e o cron QUEBRA — de propósito: drenador que
# fica verde sem drenar é a falha do tec-daily-updater (respondia 200 e não
# atualizava). O mesmo valor vai no secret DRAIN_TOKEN do repositório.
ATLAS_DRAIN_TOKEN=

# SÓ DEV: aceita URL de webhook http:// e apontando pra endereço interno
# (localhost), pra dar pra exercitar a F3 fora de produção. NUNCA em prod —
# é exatamente a trava de SSRF.
# ATLAS_WEBHOOK_ALLOW_PRIVATE=1

# === Seed do testadmin ===
# Em sqlite local seeda por padrão (os e2e do front logam como testadmin). Em
# prod (postgres) NÃO seeda a menos que ENABLE_TEST_SEED=1. SKIP_TEST_SEED
# desliga de vez (setado pelo conftest do pytest).
# ENABLE_TEST_SEED=1
# SKIP_TEST_SEED=1
